# --- TallyConnect API ---------------------------------------------------------
# Copy this file to `.env.local` and fill in real values, then restart `npm run dev`.
# `.env.local` is git-ignored.

# Base URL of the TallyConnect gateway (no trailing slash).
# Leave BLANK to send requests to the same origin / the dev proxy below.
VITE_TALLY_API_URL=http://localhost:8000

# API key issued by a TallyConnect admin (POST /api/v1/admin/keys).
# A `read_only` role key is enough for this read-only module.
VITE_TALLY_API_KEY=tc_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: when set, `npm run dev` proxies /api and /health to this target so the
# browser makes same-origin requests (no CORS config needed on the gateway).
# If you use this, set VITE_TALLY_API_URL= (blank).
# VITE_TALLY_PROXY_TARGET=http://localhost:8000
